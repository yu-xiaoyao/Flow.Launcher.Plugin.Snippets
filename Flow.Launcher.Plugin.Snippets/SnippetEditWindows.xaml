<Window x:Class="Flow.Launcher.Plugin.Snippets.SnippetEditWindows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="{DynamicResource snippets_plugin_edit_snippet}"
        Height="600" Width="800"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PopuBGColor}"
        Foreground="{DynamicResource PopupTextColor}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1"
                       Margin="8 0 0 0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource Color05B}"
                       Text="{DynamicResource snippets_plugin_edit_snippet}" />
            <Button Grid.Column="2"
                    Click="OnCancelButtonClick"
                    Style="{StaticResource TitleBarCloseButtonStyle}">
                <Path Width="46" Height="32"
                      Data="M 18,11 27,20 M 18,20 27,11"
                      Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                      StrokeThickness="1">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Button>
        </Grid>

        <!-- Top Toolbar: Key, Favorite, Syntax, Folder, Save, Cancel -->
        <Border Grid.Row="1" Height="60" Background="{DynamicResource Color14B}" Padding="12 0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Key -->
                <TextBlock Grid.Column="0" Text="{DynamicResource snippets_plugin_snippets_key}"
                           VerticalAlignment="Center" Margin="0 0 6 0" />
                <TextBox Grid.Column="1" x:Name="TbKey" FontSize="13" />

                <!-- Favorite -->
                <ToggleButton Grid.Column="2" x:Name="BtnFavorite"
                              Margin="10 0 6 0"
                              Width="28" Height="28"
                              ToolTip="{DynamicResource snippets_plugin_favorites}">
                    <Path Data="M 12,2 L 15,9 L 22,9 L 16.5,13.5 L 18.5,21 L 12,16.5 L 5.5,21 L 7.5,13.5 L 2,9 L 9,9 Z"
                          Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                          Stretch="Uniform" Width="16" Height="16" />
                </ToggleButton>

                <!-- Syntax -->
                <TextBlock Grid.Column="3" Text="Syntax"
                           VerticalAlignment="Center" Margin="6 0 6 0" />
                <ComboBox Grid.Column="4" x:Name="CbSyntax" Width="120" FontSize="13" />

                <!-- Folder -->
                <TextBlock Grid.Column="6" Text="{DynamicResource snippets_plugin_snippets_folder}"
                           VerticalAlignment="Center" Margin="10 0 6 0" />
                <ComboBox Grid.Column="7" x:Name="CbFolder" FontSize="13" />

                <!-- Save & Cancel -->
                <Button Grid.Column="9" x:Name="BtnSave"
                        MinWidth="80" Margin="0 0 8 0"
                        Content="{DynamicResource snippets_plugin_save}"
                        Click="OnSaveButtonClick"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Grid.Column="10" x:Name="BtnCancel"
                        MinWidth="80"
                        Content="{DynamicResource snippets_plugin_close}"
                        Click="OnCancelButtonClick" />
            </Grid>
        </Border>

        <!-- Bottom: AvalonEdit -->
        <avalonEdit:TextEditor Grid.Row="2"
                               x:Name="Editor"
                               FontFamily="Consolas"
                               FontSize="14"
                               ShowLineNumbers="True"
                               Margin="4"
                               Background="{DynamicResource Color01B}"
                               Foreground="{DynamicResource PopupTextColor}" />
    </Grid>
</Window>
