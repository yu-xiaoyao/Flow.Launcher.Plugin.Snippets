<Window x:Class="Flow.Launcher.Plugin.Snippets.SnippetEditWindows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="{DynamicResource snippets_plugin_edit_snippet}"
        Width="1180"
        Height="600"
        MinWidth="940"
        MinHeight="600"
        ResizeMode="CanResize"
        mc:Ignorable="d"
        Background="{DynamicResource PopuBGColor}"
        Foreground="{DynamicResource PopupTextColor}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="Close" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="Close" Executed="OnCloseExecuted" />
    </Window.CommandBindings>


    <!-- Windows UI View -->
    <Grid>
        <Border Style="{StaticResource WindowMainPanelStyle}">
            <Grid Background="{DynamicResource Color01B}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  TitleBar and Control  -->
                <Image x:Name="IconImage"
                       Grid.Row="0"
                       Grid.Column="0"
                       Width="16"
                       Height="16"
                       Margin="10 4 4 4"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="4 0 0 0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource Color05B}"
                    Text="{DynamicResource snippets_plugin_manage_snippets}" />


                <Button
                    Name="MaximizeButton"
                    Grid.Row="0"
                    Grid.Column="2"
                    Click="OnMaximizeRestoreButtonClick"
                    Style="{StaticResource TitleBarButtonStyle}">
                    <Path
                        Width="46"
                        Height="32"
                        Data="M 18.5,10.5 H 27.5 V 19.5 H 18.5 Z"
                        Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        StrokeThickness="1">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                                        Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <Button
                    Name="RestoreButton"
                    Grid.Row="0"
                    Grid.Column="2"
                    Click="OnMaximizeRestoreButtonClick"
                    Style="{StaticResource TitleBarButtonStyle}">
                    <Path
                        Width="46"
                        Height="32"
                        Data="M 18.5,12.5 H 25.5 V 19.5 H 18.5 Z M 20.5,12.5 V 10.5 H 27.5 V 17.5 H 25.5"
                        Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        StrokeThickness="1">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                                        Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <Button
                    Grid.Row="0"
                    Grid.Column="3"
                    Click="OnCloseButtonClick"
                    Style="{StaticResource TitleBarCloseButtonStyle}">
                    <Path
                        Width="46"
                        Height="32"
                        Data="M 18,11 27,20 M 18,20 27,11"
                        Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        StrokeThickness="1">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                                        Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>


                <!-- Data Container -->
                <!-- Top Toolbar: Key, Favorite, Syntax, Folder, Save, Cancel -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5"
                        Height="60" Background="{DynamicResource Color14B}" CornerRadius="4"
                        Padding="5 0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <!-- Favorite -->
                            <ColumnDefinition Width="Auto" />

                            <!-- SnippetName -->
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="200" />

                            <!-- Folder -->
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />

                            <!-- Syntax -->
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />

                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Favorite -->
                        <ToggleButton Grid.Column="0" x:Name="BtnFavorite"
                                      Width="40" Height="28" Margin="5 0"
                                      ToolTip="{DynamicResource snippets_plugin_favorites}">
                            <Path
                                Data="M 12,2 L 15,9 L 22,9 L 16.5,13.5 L 18.5,21 L 12,16.5 L 5.5,21 L 7.5,13.5 L 2,9 L 9,9 Z"
                                Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                Stretch="Uniform" Width="16" Height="16" />
                        </ToggleButton>


                        <!-- SnippetName -->
                        <TextBlock Grid.Column="1" Text="{DynamicResource snippets_plugin_snippets_key}"
                                   VerticalAlignment="Center" Margin="5 0" />
                        <Border Grid.Column="2" VerticalAlignment="Center" Margin="5 0">
                            <TextBox x:Name="TbSnippetName" FontSize="13" />
                        </Border>

                        <!-- Folder -->
                        <TextBlock Grid.Column="3" Text="{DynamicResource snippets_plugin_snippets_folder}"
                                   VerticalAlignment="Center" Margin="5 0" />
                        <ComboBox Grid.Column="4" x:Name="CbFolder" FontSize="13" MinWidth="160" MaxWidth="250"
                                  Width="200"
                                  Margin="5 0"
                                  ItemsSource="{Binding Folders}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id" />

                        <!-- Syntax -->
                        <TextBlock Grid.Column="5" Text="{DynamicResource snippets_plugin_snippet_syntax}"
                                   VerticalAlignment="Center" Margin="5 0" />
                        <ComboBox Grid.Column="6" x:Name="CbSyntax" FontSize="13" Width="120" Margin="5 0"
                                  SelectionChanged="OnSyntaxSelectionChanged" />

                        <!-- Save & Cancel -->
                        <Button Grid.Column="7" x:Name="BtnSaveOrUpdate"
                                MinWidth="80" Margin="5 0"
                                Content=""
                                Click="OnSaveButtonClick"
                                Style="{DynamicResource AccentButtonStyle}" />
                        <Button Grid.Column="8" x:Name="BtnCancel"
                                MinWidth="80"
                                Margin="5 0"
                                Content="{DynamicResource snippets_plugin_close}"
                                Click="OnCancelButtonClick" />
                    </Grid>
                </Border>


                <!-- Bottom: AvalonEdit -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Padding="4">
                    <avalonEdit:TextEditor
                        x:Name="Editor"
                        FontFamily="Consolas"
                        FontSize="13"
                        ShowLineNumbers="True"
                        Background="{DynamicResource Color01B}"
                        Foreground="{DynamicResource PopupTextColor}" />
                </Border>


            </Grid>
        </Border>
    </Grid>


</Window>