<Window x:Class="Flow.Launcher.Plugin.Snippets.FolderEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        Width="480"
        Height="312"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        
        mc:Ignorable="d"
        Background="{DynamicResource PopuBGColor}"
        Foreground="{DynamicResource PopupTextColor}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="Close" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="Close" Executed="OnCloseExecuted" />
    </Window.CommandBindings>

    <StackPanel Orientation="Vertical">
        <!-- Custom Windows Bar. Height: 32 -->
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="4"
                    Click="OnCancelButtonClick"
                    Style="{StaticResource TitleBarCloseButtonStyle}">
                    <Path
                        Width="46"
                        Height="32"
                        Data="M 18,11 27,20 M 18,20 27,11"
                        Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        StrokeThickness="1">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                                        Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Title Bar. Height: 32 -->
        <DockPanel Margin="26,0,26,0">
            <StackPanel Margin="0,0,0,12" DockPanel.Dock="Top">
                <TextBlock
                    Margin="0,0,0,0"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="{Binding TitleName}"
                    TextAlignment="Left" />
            </StackPanel>
        </DockPanel>
        <!-- Windows Title Bar And Title Bar Height: 64 -->

        <StackPanel>
            <!-- Content Area -->
            <StackPanel Orientation="Vertical">

                <Grid Margin="30,0,30,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label
                        Grid.Row="0" Grid.Column="0"
                        x:Name="LabelName"
                        Margin="8 16"
                        VerticalAlignment="Center"
                        Content="{DynamicResource snippets_plugin_snippets_folder_name}" />
                    <TextBox
                        Grid.Row="0" Grid.Column="1"
                        x:Name="TbName"
                        Margin="8 16"
                        Text="" />

                    <Label
                        Grid.Row="1" Grid.Column="0"
                        x:Name="LabelCreateTime"
                        Margin="8 16"
                        VerticalAlignment="Center"
                        Content="{DynamicResource snippets_plugin_create_time}" />
                    <TextBlock
                        Grid.Row="1" Grid.Column="1"
                        x:Name="TbCreateTime"
                        Margin="8 16"
                        VerticalAlignment="Center"
                        Text="" />

                    <Label
                        Grid.Row="2" Grid.Column="0"
                        x:Name="LabelUpdateTime"
                        Margin="8 16"
                        VerticalAlignment="Center"
                        Content="{DynamicResource snippets_plugin_update_time}" />
                    <TextBlock
                        Grid.Row="2" Grid.Column="1"
                        x:Name="TbUpdateTime"
                        Margin="8 16"
                        VerticalAlignment="Center"
                        Text="" />
                </Grid>

            </StackPanel>

            <!-- Bottom Button Bar -->
            <Border Height="80"
                    Background="{DynamicResource PopupButtonAreaBGColor}"
                    BorderBrush="{DynamicResource PopupButtonAreaBorderColor}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Margin="8 16">
                    <Button
                        MinWidth="120"
                        Margin="5,0,5,0"
                        Click="OnCancelButtonClick"
                        Content="{DynamicResource snippets_plugin_close}" />
                    <Button
                        MinWidth="120"
                        Margin="5,0,5,0"
                        Click="SaveAndCloseButtonClick"
                        Content="{DynamicResource snippets_plugin_save_and_close}"
                        Style="{DynamicResource AccentButtonStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </StackPanel>
    
    
</Window>