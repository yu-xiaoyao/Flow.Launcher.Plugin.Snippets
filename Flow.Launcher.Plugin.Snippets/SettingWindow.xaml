<Window x:Class="Flow.Launcher.Plugin.Snippets.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:conv="clr-namespace:Flow.Launcher.Plugin.Snippets.UI.Converters"
        Title="{DynamicResource snippets_plugin_manage_snippets}"
        Width="1280"
        Height="720"
        MinWidth="960"
        MinHeight="640"
        Closed="OnClosed"
        Loaded="OnLoaded"
        StateChanged="Window_StateChanged"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"

        Background="{DynamicResource PopuBGColor}"
        Foreground="{DynamicResource PopupTextColor}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" />
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="Close" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="Close" Executed="OnCloseExecuted" />
    </Window.CommandBindings>

    <Window.Resources>
        <Style x:Key="BorderSelectableBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Color06B}" />
            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Color14B}" />
                </Trigger>

                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Color18B}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />

        <conv:SnippetFavoritesToBoolConverter x:Key="SnippetFavoritesToBoolConverter" />

    </Window.Resources>

    <!-- Windows UI View -->
    <Grid>
        <Border Style="{StaticResource WindowMainPanelStyle}">
            <Grid Background="{DynamicResource Color01B}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  TitleBar and Control  -->
                <Image x:Name="IconImage"
                       Grid.Row="0"
                       Grid.Column="0"
                       Width="16"
                       Height="16"
                       Margin="10 4 4 4"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="4 0 0 0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource Color05B}"
                    Text="{DynamicResource snippets_plugin_manage_snippets}" />

                <Button
                    Grid.Row="0"
                    Grid.Column="2"
                    Click="OnMinimizeButtonClick"
                    RenderOptions.EdgeMode="Aliased"
                    Style="{DynamicResource TitleBarButtonStyle}">
                    <Path
                        Width="46"
                        Height="32"
                        Data="M 18,15 H 28"
                        Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        StrokeThickness="1">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                                        Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <Button
                    Name="MaximizeButton"
                    Grid.Row="0"
                    Grid.Column="3"
                    Click="OnMaximizeRestoreButtonClick"
                    Style="{StaticResource TitleBarButtonStyle}">
                    <Path
                        Width="46"
                        Height="32"
                        Data="M 18.5,10.5 H 27.5 V 19.5 H 18.5 Z"
                        Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        StrokeThickness="1">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                                        Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <Button
                    Name="RestoreButton"
                    Grid.Row="0"
                    Grid.Column="3"
                    Click="OnMaximizeRestoreButtonClick"
                    Style="{StaticResource TitleBarButtonStyle}">
                    <Path
                        Width="46"
                        Height="32"
                        Data="M 18.5,12.5 H 25.5 V 19.5 H 18.5 Z M 20.5,12.5 V 10.5 H 27.5 V 17.5 H 25.5"
                        Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        StrokeThickness="1">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                                        Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <Button
                    Grid.Row="0"
                    Grid.Column="4"
                    Click="OnCloseButtonClick"
                    Style="{StaticResource TitleBarCloseButtonStyle}">
                    <Path
                        Width="46"
                        Height="32"
                        Data="M 18,11 27,20 M 18,20 27,11"
                        Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        StrokeThickness="1">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding Path=IsActive, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                                        Value="False">
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>


                <!-- Data Container -->
                <Grid
                    x:Name="NavView"
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="5"
                    Margin="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource Color01B}">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" MinWidth="160" MaxWidth="560" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Panel: Folder List-->
                    <Border
                        Grid.Column="0"
                        Margin="0"
                        Background="{DynamicResource Color01B}"
                        CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Height="60" Background="{DynamicResource Color14B}"
                                    CornerRadius="4">
                                <Image Name="Logo" Width="48" Height="48"></Image>
                            </Border>

                            <Border Grid.Row="1" CornerRadius="4">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0">

                                        <Border CornerRadius="4" Height="32"
                                                Margin="8 4 8 2"
                                                Style="{StaticResource BorderSelectableBorderStyle}"
                                                DataContext="{Binding FolderAllSnippets}"
                                                MouseLeftButtonUp="AllSnippetsFolder_MouseLeftButtonUp"
                                                MouseRightButtonUp="AllSnippetsFolder_MouseRightButtonUp">
                                            <TextBlock Text="{DynamicResource snippets_plugin_all_snippets}"
                                                       Margin="4 0" VerticalAlignment="Center" />
                                        </Border>

                                        <Border CornerRadius="4" Height="32"
                                                Margin="8 2"
                                                Style="{StaticResource BorderSelectableBorderStyle}"
                                                DataContext="{Binding FolderFavorites}"
                                                MouseLeftButtonUp="FavoritesFolder_MouseLeftButtonUp"
                                                MouseRightButtonUp="FavoritesFolder_MouseRightButtonUp">
                                            <TextBlock Text="{DynamicResource snippets_plugin_favorites}" Margin="4 0"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Border CornerRadius="4" Height="32"
                                                Margin="8 2 8 4"
                                                Style="{StaticResource BorderSelectableBorderStyle}"
                                                DataContext="{Binding FolderRecent}"
                                                MouseLeftButtonUp="RecentFolder_MouseLeftButtonUp"
                                                MouseRightButtonUp="RecentFolder_MouseRightButtonUp">
                                            <TextBlock Text="{DynamicResource snippets_plugin_recent}" Margin="4 0"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Border CornerRadius="4" Height="32"
                                                Margin="8 2 8 4"
                                                Style="{StaticResource BorderSelectableBorderStyle}"
                                                DataContext="{Binding FolderNo}"
                                                MouseLeftButtonUp="NoFolder_MouseLeftButtonUp"
                                                MouseRightButtonUp="NoFolder_MouseRightButtonUp">
                                            <TextBlock Text="{DynamicResource snippets_plugin_no_folder}" Margin="4 0"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>

                                    <Border Grid.Row="1"
                                            CornerRadius="4">
                                        <TextBlock Text="{DynamicResource snippets_plugin_snippets_folder}"
                                                   VerticalAlignment="Center" FontSize="14"
                                                   HorizontalAlignment="Center" Margin="8 4" />
                                    </Border>

                                    <Border Grid.Row="2">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">

                                            <ItemsControl ItemsSource="{Binding Folders}">
                                                <ItemsControl.ItemTemplate>
                                                    <ItemContainerTemplate>
                                                        <Border CornerRadius="4" Height="32"
                                                                Margin="8 2 8 2"
                                                                Style="{StaticResource BorderSelectableBorderStyle}"
                                                                MouseLeftButtonUp="FolderList_MouseLeftButtonUp"
                                                                MouseRightButtonUp="FolderList_MouseRightButtonUp">
                                                            <Border.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem
                                                                        Header="{DynamicResource snippets_plugin_move_up}"
                                                                        Click="FolderList_MoveUpOnClick" />
                                                                    <MenuItem
                                                                        Header="{DynamicResource snippets_plugin_move_down}"
                                                                        Click="FolderList_MoveDownOnClick" />
                                                                    <Separator />
                                                                    <MenuItem
                                                                        Header="{DynamicResource snippets_plugin_rename}"
                                                                        Click="FolderList_RenameFolderOnClick" />
                                                                    <MenuItem
                                                                        Header="{DynamicResource snippets_plugin_delete}"
                                                                        Click="FolderList_DeleteFolderOnClick" />
                                                                    <Separator />
                                                                    <MenuItem
                                                                        Header="{DynamicResource snippets_plugin_move_top}"
                                                                        Click="FolderList_MoveTopOnClick" />
                                                                    <MenuItem
                                                                        Header="{DynamicResource snippets_plugin_move_bottom}"
                                                                        Click="FolderList_MoveBottomOnClick" />
                                                                </ContextMenu>
                                                            </Border.ContextMenu>
                                                            <TextBlock Text="{Binding Name}" Margin="4 0"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                    </ItemContainerTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </ScrollViewer>
                                    </Border>
                                </Grid>

                            </Border>

                            <Border Grid.Row="2" CornerRadius="4" Height="44"
                                    Background="{DynamicResource Color14B}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                    <Button Content="{DynamicResource snippets_plugin_add_folder}" FontSize="13"
                                            Click="BtnAddFolder_OnClick" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Splitter -->
                    <GridSplitter
                        Grid.Column="1"
                        Width="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource Color03B}"
                        ResizeBehavior="PreviousAndNext" />

                    <!-- Right Panel: Select Folder Snippets -->
                    <Border
                        Grid.Column="2"
                        Margin="0"
                        CornerRadius="4">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="60" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>


                            <Border Grid.Row="0" Background="{DynamicResource Color14B}" CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            CornerRadius="4">
                                        <ComboBox Width="100" FontSize="13" HorizontalAlignment="Center"
                                                  IsEnabled="False">
                                            <ComboBoxItem Content="正常" FontSize="13" />
                                            <ComboBoxItem Content="语法" FontSize="13" />
                                        </ComboBox>
                                    </Border>

                                    <Border Grid.Column="1" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" VerticalAlignment="Center" Margin="4 0 0 0">
                                                <Label Content="{DynamicResource snippets_plugin_snippets_name}"
                                                       FontSize="13" />
                                            </Border>
                                            <Border Grid.Column="1" Margin="4 0 0 0">
                                                <TextBox x:Name="TbFilterName" FontSize="13" />
                                            </Border>

                                            <Border Grid.Column="2" VerticalAlignment="Center" Margin="4 0 0 0">
                                                <Label Content="{DynamicResource snippets_plugin_snippets_value}"
                                                       FontSize="13" />
                                            </Border>
                                            <Border Grid.Column="3" Margin="4 0 0 0">
                                                <TextBox x:Name="TbFilterValue" FontSize="13" />
                                            </Border>

                                            <Border Grid.Column="4" VerticalAlignment="Center" Margin="4 0 0 0">
                                                <Label Content="{DynamicResource snippets_plugin_snippets_folder}"
                                                       FontSize="13" />
                                            </Border>
                                            <Border Grid.Column="5" Margin="4 0 0 0">
                                                <TextBox x:Name="TbFilterFolder" FontSize="13" />
                                            </Border>

                                            <Border Grid.Column="6" VerticalAlignment="Center" Margin="4 0 0 0">
                                                <Button FontSize="13"
                                                        Content="{DynamicResource snippets_plugin_filter}"
                                                        Click="BtnFilter_OnClick"
                                                        Width="84" />
                                            </Border>
                                            <Border Grid.Column="7" Margin="4 0 0 0">
                                                <Button FontSize="13" Content="{DynamicResource snippets_plugin_reset}"
                                                        Click="BtnReset_OnClick"
                                                        Width="84" />
                                            </Border>

                                        </Grid>
                                    </Border>
                                    <Border Grid.Column="2" CornerRadius="4" Margin="4 0"
                                            VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Button FontSize="13" Content="{DynamicResource snippets_plugin_add_snippet}"
                                                Width="110" Click="BtnAddSnippets_Click" />
                                    </Border>

                                </Grid>
                            </Border>

                            <Border Grid.Row="1" x:Name="SnippetsContainer" Margin="4"
                                    BorderBrush="{DynamicResource Color03B}">

                                <DataGrid x:Name="DataGridSnippets"
                                          ItemsSource="{Binding Snippets}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="True"
                                          SelectionMode="Extended"
                                          SelectionUnit="FullRow"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          MouseDoubleClick="DataGridSnippets_MouseDoubleClick"
                                          ContextMenuOpening="DataGridSnippets_OnContextMenuOpening">

                                    <DataGrid.CommandBindings>
                                        <CommandBinding Command="Delete"
                                                        CanExecute="DataGridSnippetsCommandBinding_OnCanExecute"
                                                        Executed="DataGridSnippetsCommandBinding_OnExecuted" />
                                    </DataGrid.CommandBindings>

                                    <DataGrid.ContextMenu>
                                        <ContextMenu x:Name="SnippetContextMenu">
                                            <MenuItem
                                                x:Name="SnippetContextMenuEdit"
                                                Header="{DynamicResource snippets_plugin_edit}"
                                                Click="DataGrid_EditSnippetOnClick" />
                                            <MenuItem
                                                x:Name="SnippetContextMenuDelete"
                                                Header="{DynamicResource snippets_plugin_delete}"
                                                Click="DataGrid_DeleteSnippetOnClick" />
                                            <MenuItem
                                                x:Name="SnippetContextMenuMoveUp"
                                                Header="{DynamicResource snippets_plugin_move_up}"
                                                Click="DataGrid_MoveUpOnClick" />
                                            <MenuItem
                                                x:Name="SnippetContextMenuMoveDown"
                                                Header="{DynamicResource snippets_plugin_move_down}"
                                                Click="DataGrid_MoveDownOnClick" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>

                                    <DataGrid.Columns>

                                        <DataGridTemplateColumn Width="3*" MinWidth="100">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="{DynamicResource snippets_plugin_snippets_name}"
                                                           HorizontalAlignment="Center" />
                                            </DataGridTemplateColumn.Header>

                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Height="36" MaxHeight="36" Margin="4 2"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   ToolTip="{Binding Name}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="13" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Value -->
                                        <DataGridTemplateColumn Width="6*" MinWidth="100">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="{DynamicResource snippets_plugin_snippets_value}"
                                                           HorizontalAlignment="Center" />
                                            </DataGridTemplateColumn.Header>

                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Height="36" MaxHeight="36" Margin="4 2"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Value}"
                                                                   ToolTip="{Binding Value}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="13" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Folder -->
                                        <DataGridTemplateColumn Width="140" MinWidth="120" MaxWidth="200">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="{DynamicResource snippets_plugin_snippets_folder}"
                                                           HorizontalAlignment="Center" />
                                            </DataGridTemplateColumn.Header>

                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Height="36" MaxHeight="36" Margin="4 2"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding FolderName}"
                                                                   ToolTip="{Binding FolderName}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="13" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>


                                        <DataGridTemplateColumn MinWidth="48" MaxWidth="64">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="{DynamicResource snippets_plugin_favorites}"
                                                           HorizontalAlignment="Center" />
                                            </DataGridTemplateColumn.Header>

                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            Margin="4 2">
                                                        <ToggleButton
                                                            IsHitTestVisible="False"
                                                            ToolTip="{DynamicResource snippets_plugin_favorites}"
                                                            IsChecked="{Binding Faviorites, Converter={StaticResource SnippetFavoritesToBoolConverter}}">
                                                            <Path
                                                                Data="M 12,2 L 15,9 L 22,9 L 16.5,13.5 L 18.5,21 L 12,16.5 L 5.5,21 L 7.5,13.5 L 2,9 L 9,9 Z"
                                                                Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}"
                                                                Stretch="Uniform" Height="12" Width="12" />
                                                        </ToggleButton>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>


                                        <!-- CreateTime -->
                                        <DataGridTemplateColumn Width="160" MinWidth="120">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="{DynamicResource snippets_plugin_create_time}"
                                                           HorizontalAlignment="Center" />
                                            </DataGridTemplateColumn.Header>

                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Height="36" MaxHeight="36" Margin="4 2"
                                                            VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            FontSize="13" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- UpdateTime -->
                                        <DataGridTemplateColumn Width="160" MinWidth="120">
                                            <DataGridTemplateColumn.Header>
                                                <TextBlock Text="{DynamicResource snippets_plugin_update_time}"
                                                           HorizontalAlignment="Center" />
                                            </DataGridTemplateColumn.Header>

                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Height="36" MaxHeight="36" Margin="4 2"
                                                            VerticalAlignment="Center">
                                                        <TextBlock
                                                            Text="{Binding UpdateTime, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            FontSize="13" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                        </Grid>

                    </Border>

                </Grid>


            </Grid>
        </Border>
    </Grid>


</Window>